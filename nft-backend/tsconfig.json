{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",

    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],

    "types": ["node"],

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    "rootDir": ".",
    "outDir": "./dist"
  },

  "include": [
    "src/**/*"
  ]
}